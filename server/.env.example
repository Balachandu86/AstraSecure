# Copy to .env and fill in values before running

# PostgreSQL connection string
# Local: postgres://user:password@localhost:5432/astrasecure
# Docker: postgres://postgres:secret@localhost:5432/astrasecure
DATABASE_URL=postgres://postgres:secret@localhost:5432/astrasecure

# JWT signing secret — change to a long random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Port the HTTP server listens on
PORT=3000

# Bind address — 0.0.0.0 listens on all interfaces (required for LAN / physical device access)
# Change to 127.0.0.1 to restrict to localhost only
HOST=0.0.0.0

# TLS (optional — set both to enable HTTPS instead of HTTP)
# TLS_CERT=/path/to/server.crt
# TLS_KEY=/path/to/server.key
